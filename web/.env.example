# Copy this file to .env.local and fill it in. .env.local is git-ignored, never commit it.

# MongoDB Atlas connection string, from Atlas > Connect > Drivers.
# Leave it empty to run with in-memory data instead (everything resets when the server restarts).
MONGODB_URI=
MONGODB_DB=printpix

# The first admin, created once when the database has no admin yet.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Signs the login cookie. Any long random string. Without it everyone is signed out on each restart.
SESSION_SECRET=
